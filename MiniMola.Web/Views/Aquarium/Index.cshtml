@{
    ViewData["Title"] = "Akvaryumum";
}

<link rel="stylesheet"
      href="~/css/aquarium.css"
      asp-append-version="true" />

<section id="aquarium-page"
         class="aquarium-page"
         data-api-url="@Url.Content("~/api/aquarium")"
         data-upgrade-url="@Url.Content("~/api/aquarium/upgrade")">

    @Html.AntiForgeryToken()

    <header class="aquarium-header">
        <div>
            <span class="aquarium-eyebrow">MiniMola</span>
            <h1 id="aquarium-name">Akvaryumum</h1>
            <p>
                Merhaba
                <strong id="aquarium-user-name">...</strong>
            </p>
        </div>

        <div class="point-badge"
             title="Kullanılabilir puanın">
            <span class="point-icon">
                <svg viewBox="0 0 18 24" aria-hidden="true">
                    <path d="M9 1S2 11 2 16c0 4 3 7 7 7s7-3 7-7C16 11 9 1 9 1Z"
                          fill="currentColor" />
                </svg>
            </span>
            <strong id="aquarium-point-balance">0</strong>
            <span>Damla</span>
        </div>
    </header>

    <div class="aquarium-frame">
        <div class="aquarium-frame-tip">
            <span class="tip-dot"></span>
            Dekorasyonları sürükleyerek yerini değiştirebilirsin
        </div>

        <div id="aquarium-canvas-host"
             class="aquarium-canvas-host"
             role="img"
             aria-label="Kişisel sanal akvaryumun">

            <div id="aquarium-loading"
                 class="aquarium-loading">
                <div class="loading-bubble"></div>
                <span>Akvaryum hazırlanıyor...</span>
            </div>
        </div>
    </div>
        <dialog id="fish-detail-dialog"
            class="fish-detail-dialog"
            aria-labelledby="fish-detail-name">

        <div class="fish-detail-card">
            <button id="fish-detail-close"
                    class="fish-detail-close"
                    type="button"
                    aria-label="Balık detaylarını kapat">
                <svg viewBox="0 0 24 24"
                     aria-hidden="true">
                    <path d="M6 6l12 12M18 6 6 18" />
                </svg>
            </button>

            <div class="fish-detail-visual">
                <div id="fish-detail-avatar"
                     class="fish-detail-avatar"
                     aria-hidden="true">
                    <svg viewBox="0 0 80 52">
                        <path class="fish-avatar-tail"
                              d="M22 26 4 10v32l18-16Z" />

                        <ellipse class="fish-avatar-body"
                                 cx="46"
                                 cy="26"
                                 rx="28"
                                 ry="18" />

                        <circle class="fish-avatar-eye-white"
                                cx="61"
                                cy="20"
                                r="5" />

                        <circle class="fish-avatar-eye"
                                cx="62"
                                cy="20"
                                r="2" />
                    </svg>
                </div>

                <span class="fish-detail-eyebrow">
                    BALIK PROFİLİ
                </span>

                <h2 id="fish-detail-name">
                    Balığım
                </h2>

                <p id="fish-detail-description">
                    Balık bilgileri hazırlanıyor...
                </p>
            </div>

            <dl class="fish-detail-properties">
                <div>
                    <dt>Tür</dt>
                    <dd id="fish-detail-species">-</dd>
                </div>

                <div>
                    <dt>Nadirlik</dt>
                    <dd id="fish-detail-rarity">-</dd>
                </div>

                <div>
                    <dt>Aramıza katıldığı tarih</dt>
                    <dd id="fish-detail-acquired">-</dd>
                </div>
            </dl>

                    <div class="fish-care-panel">
            <div class="fish-care-header">
                <div>
                    <span id="fish-care-status"
                          class="fish-care-status">
                        Acıkmış
                    </span>

                    <strong id="fish-happiness-value">
                        %35 mutluluk
                    </strong>
                </div>

                <button id="fish-feed-button"
                        type="button">
                    Balığı besle
                </button>
            </div>

            <div class="fish-happiness-track"
                 role="progressbar"
                 aria-label="Balığın mutluluk oranı"
                 aria-valuemin="0"
                 aria-valuemax="100"
                 aria-valuenow="35">

                <span id="fish-happiness-bar"
                      style="width: 35%">
                </span>
            </div>

            <small id="fish-feeding-info">
                Bu balık henüz beslenmedi.
            </small>
        </div>

            <form id="fish-nickname-form"
                  class="fish-nickname-form">

                <label for="fish-nickname-input">
                    Balığının adı
                </label>

                <div class="fish-nickname-controls">
                    <input id="fish-nickname-input"
                           name="nickname"
                           type="text"
                           minlength="1"
                           maxlength="20"
                           autocomplete="off"
                           required />

                    <button id="fish-nickname-submit"
                            type="submit">
                        Adı kaydet
                    </button>
                </div>

                <small>
                    En fazla 20 karakter kullanabilirsin.
                </small>

                <p id="fish-detail-message"
                   class="fish-detail-message"
                   role="status"
                   aria-live="polite">
                </p>
            </form>
        </div>
    </dialog>

    <footer class="aquarium-status">
        <div class="status-item">
            <span>Seviye</span>
            <strong id="aquarium-level">1</strong>
        </div>

        <div class="status-item">
            <span>Balıklar</span>
            <strong>
                <span id="aquarium-fish-count">0</span>
                /
                <span id="aquarium-capacity">5</span>
            </strong>
        </div>

        <div class="status-message">
            Balığına tıklayarak onunla etkileşime geçebilirsin.
        </div>
    </footer>

    <div class="aquarium-quick-actions">
        <div class="aquarium-quick-copy">
            <span>Biraz değişiklik iyi gelir</span>
            <strong>Akvaryumunu kendi zevkine göre düzenle.</strong>
        </div>

        <div class="aquarium-quick-links">
            <a asp-controller="Shop"
               asp-action="Index">
                Yeni balık seç
            </a>

            <a asp-controller="Shop"
               asp-action="Decorations"
               class="is-primary">
                Dekorasyon ekle
            </a>
        </div>
    </div>

    <aside class="aquarium-upgrade-panel"
           aria-labelledby="aquarium-upgrade-title">

        <div class="upgrade-copy">
            <span class="aquarium-eyebrow">
                Akvaryum gelişimi
            </span>

            <h2 id="aquarium-upgrade-title">
                Akvaryumunu büyüt
            </h2>

            <p>
                Seviyeni yükselterek daha fazla balık için
                yer açabilir ve yeni türlerin kilidini
                kaldırabilirsin.
            </p>
        </div>

        <div class="upgrade-levels">
            <div class="upgrade-value">
                <span>Mevcut seviye</span>
                <strong id="upgrade-current-level">-</strong>
            </div>

            <span class="upgrade-arrow"
                  aria-hidden="true">→</span>

            <div class="upgrade-value upgrade-value-next">
                <span>Yeni seviye</span>
                <strong id="upgrade-next-level">-</strong>
            </div>
        </div>

        <div class="upgrade-capacity">
            <span>Kapasite</span>

            <strong>
                <span id="upgrade-current-capacity">-</span>
                <span aria-hidden="true">→</span>
                <span id="upgrade-next-capacity">-</span>
            </strong>
        </div>

        <div class="upgrade-action">
            <div class="upgrade-price">
                <span>Yükseltme bedeli</span>

                <strong>
                    <svg viewBox="0 0 18 24" aria-hidden="true">
                        <path d="M9 1S2 11 2 16c0 4 3 7 7 7s7-3 7-7C16 11 9 1 9 1Z"
                              fill="currentColor" />
                    </svg>
                    <span id="upgrade-cost">-</span>
                    Damla
                </strong>
            </div>

            <button id="aquarium-upgrade-button"
                    class="aquarium-upgrade-button"
                    type="button"
                    disabled>
                Akvaryumu yükselt
            </button>
        </div>

        <p id="aquarium-upgrade-message"
           class="aquarium-upgrade-message"
           role="status"
           aria-live="polite">
            Yükseltme bilgileri hazırlanıyor...
        </p>
    </aside>

    <noscript>
        Akvaryumu görüntülemek için JavaScript’i
        etkinleştirmelisin.
    </noscript>
</section>

@section Scripts {
    <script type="module"
            src="~/js/aquarium.bundle.js"
            asp-append-version="true"></script>
}
