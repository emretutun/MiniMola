@{
    ViewData["Title"] = "Genel bakış";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.Identity?.Name?.Split('@')[0] ?? "";
    var activities = new[] {
        ("Games", "Word", "Aa", "Günün kelimesi", "Beş harf, altı tahmin. Zihnine kısa bir mola.", "Günlük bulmaca", "lavender"),
        ("Games", "Bubble", "◌", "Baloncuk patlat", "45 saniyelik küçük bir refleks oyunu.", "Hızlı mola", "peach"),
        ("Games", "Memory", "◇", "Hafıza kartları", "Kartları aç, deniz canlılarının eşlerini bul.", "Zihin egzersizi", "blue"),
        ("Music", "Index", "♫", "Müzik ve podcast", "Spotify listelerinle molanın sesini seç.", "Kendi ritmin", "mint"),
        ("News", "Index", "☷", "Gündem", "Öne çıkan haberlerle güne kısa bir bakış.", "Keşfet", "peach"),
        ("Shop", "Index", "✧", "Akvaryum mağazası", "Biriktirdiğin Damlalarla alanını kişiselleştir.", "Yeni dostlar", "lavender")
    };
}
<section class="mm-dashboard">
    <header class="mm-page-heading">
        <div>
            <span class="mm-kicker">KENDİNE AYIRDIĞIN ZAMAN</span>
            <h1>@(signedIn ? $"Merhaba, {displayName}." : "Gününe iyi gelen bir mola.")</h1>
            <p>@(signedIn ? "Bugün ne yapmak istersin? Kaldığın yerden devam et." : "Piyasalar, mini oyunlar, müzik ve sana ait küçük bir dünya.")</p>
        </div>
        <span class="mm-date">@DateTime.Now.ToString("d MMMM yyyy", System.Globalization.CultureInfo.GetCultureInfo("tr-TR"))</span>
    </header>

    <div class="mm-dashboard-featured">
        <article class="mm-welcome">
            <span class="mm-kicker">BİRAZ YAVAŞLA</span>
            <h2>Küçük bir ara.<br />Daha iyi bir gün.</h2>
            <p>Bir oyun oyna, piyasaya göz at veya akvaryumunun sakinliğine dal. Bu zaman senin.</p>
            @if (signedIn)
            {
                <a class="mm-primary" asp-controller="Aquarium" asp-action="Index">Akvaryumuma git <span aria-hidden="true">↗</span></a>
            }
            else
            {
                <div class="mm-inline-actions">
                    <a class="mm-primary" asp-area="Identity" asp-page="/Account/Register">Ücretsiz başla <span aria-hidden="true">↗</span></a>
                    <a class="mm-text-link" asp-area="Identity" asp-page="/Account/Login">Giriş yap</a>
                </div>
            }
            <div class="mm-welcome-art" aria-hidden="true"><div class="mm-art-orbit"></div><div class="mm-art-pause"><i></i><i></i></div><span class="mm-art-dot"></span></div>
        </article>
        <div class="mm-quick-stack">
            <a class="mm-quick-card" asp-controller="Markets" asp-action="Index">
                <span class="mm-feature-icon mint" aria-hidden="true">↗</span>
                <div><span class="mm-kicker">TAKİP ET</span><h2>Piyasalar</h2><p>Favorilerin ve güncel hareketler.</p></div>
                <span class="mm-arrow" aria-hidden="true">→</span>
            </a>
            <a class="mm-quick-card" asp-controller="WorkSchedule" asp-action="Countdown">
                <span class="mm-feature-icon blue" aria-hidden="true">◷</span>
                <div><span class="mm-kicker">GÜNÜNÜ PLANLA</span><h2>Mesai sayacı</h2><p>Günün kalanını bir bakışta gör.</p></div>
                <span class="mm-arrow" aria-hidden="true">→</span>
            </a>
        </div>
    </div>

    <div class="mm-section-heading"><div><span class="mm-kicker">SANA AYRILAN ALAN</span><h2>Molanı seç</h2></div><p>Kısa bir oyun, güzel bir şarkı, yeni bir şey.</p></div>
    <div class="mm-activity-grid">
        @foreach (var item in activities)
        {
            <a class="mm-activity" asp-controller="@item.Item1" asp-action="@item.Item2">
                <div class="mm-activity-top"><span class="mm-feature-icon @item.Item7" aria-hidden="true">@item.Item3</span><span class="mm-arrow" aria-hidden="true">↗</span></div>
                <h3>@item.Item4</h3><p>@item.Item5</p><span class="mm-activity-label">@item.Item6</span>
            </a>
        }
    </div>
    <div class="mm-bottom-note"><span aria-hidden="true">✦</span><p>Her molada her şeyi yapmana gerek yok. Bugün sana iyi geleni seç.</p></div>
</section>
