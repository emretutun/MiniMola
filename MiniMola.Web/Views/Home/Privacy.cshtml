@{
    ViewData["Title"] = "Gizlilik";
}

<section class="simple-page">
    <header class="simple-page-header">
        <span class="simple-page-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M12 3 5 6v5c0 4.6 2.8 8.1 7 10 4.2-1.9 7-5.4 7-10V6l-7-3Z" />
                <path d="m9 12 2 2 4-4" />
            </svg>
        </span>
        <div>
            <span class="simple-page-eyebrow">MİNİMOLA</span>
            <h1>Gizlilik</h1>
            <p>Kişisel alanına ve bağlı hesaplarına saygı duyuyoruz.</p>
        </div>
    </header>

    <div class="simple-page-grid">
        <article>
            <h2>Hesap bilgilerin</h2>
            <p>
                Üyelik ve akvaryum ilerlemen, sana özel MiniMola deneyimini
                sunmak için yerel veritabanında saklanır.
            </p>
        </article>
        <article>
            <h2>Spotify bağlantısı</h2>
            <p>
                MiniMola Spotify şifreni görmez. Yetkilendirme Spotify üzerinden
                yapılır ve bağlantıyı Müzik sayfasından istediğin zaman kaldırabilirsin.
            </p>
        </article>
        <article>
            <h2>Haber bağlantıları</h2>
            <p>
                Haber kartları kaynak siteye yönlendirir. Açılan dış sayfalar kendi
                gizlilik ve çerez kurallarına tabidir.
            </p>
        </article>
    </div>
</section>
