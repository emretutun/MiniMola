@{
    ViewData["Title"] = "Gündem Molası";
}

<link rel="stylesheet"
      href="~/css/news.css"
      asp-append-version="true" />

<section class="news-page">
    <header class="news-hero">
        <div class="news-hero-copy">
            <span class="news-eyebrow">GÜNDEM MOLASI</span>
            <h1>Gündemi kısa<br />bir molaya sığdır.</h1>
            <p>
                Habertürk’ten güncel başlıkları tek, sakin bir akışta gözden
                geçir. Merak ettiğin haberin devamını kaynağında okuyabilirsin.
            </p>

            <div class="news-hero-meta">
                <span>Güncel başlıklar</span>
                <i aria-hidden="true"></i>
                <span>Dış bağlantılar yeni sekmede açılır</span>
            </div>
        </div>

        <div class="news-hero-action">
            <div class="news-paper-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48">
                    <path d="M13 10h22a3 3 0 0 1 3 3v24H14a4 4 0 0 1-4-4V13a3 3 0 0 1 3-3Z" />
                    <path d="M17 17h14M17 23h14M17 29h8M10 18H7v15a4 4 0 0 0 4 4" />
                </svg>
            </div>

            <button id="refresh-news-button"
                    class="news-refresh-button"
                    type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M20 11a8 8 0 1 0-2.3 5.7M20 5v6h-6" />
                </svg>
                <span>Haberleri yenile</span>
            </button>
        </div>
    </header>

    <div id="news-status"
         class="news-status"
         role="status"
         aria-live="polite">
        Haberler yükleniyor...
    </div>

    <div id="news-list"
         class="news-grid"
         aria-live="polite">
    </div>

    <footer class="news-source">
        Haber kaynağı
        <span aria-hidden="true">·</span>
        <a href="https://www.haberturk.com"
           target="_blank"
           rel="noopener noreferrer">
            Habertürk
        </a>
    </footer>
</section>

@section Scripts {
    <script src="~/js/news.bundle.js"
            asp-append-version="true"></script>
}
